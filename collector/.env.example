# Placeholder .env file for collector runtime

# Global JSON/text/urlencoded body parser limit for collector control requests.
# Large source documents should be passed through the existing file-processing paths.
# COLLECTOR_REQUEST_BODY_LIMIT=10mb

# Lite mode (default: enabled when unset)
# LIGHTWEIGHT_MODE=true
#
# Web scraping strategy:
# - WEB_SCRAPER=jina (default in Lite)
# - WEB_SCRAPER=puppeteer (requires optional puppeteer-core + Chromium)
# - WEB_SCRAPER=fetch
# WEB_SCRAPER=jina
#
# Jina Reader (optional)
# JINA_READER_API_KEY=
# JINA_READER_BASE_URL=https://r.jina.ai
# JINA_READER_TIMEOUT_MS=30000

# This enables HTTP request/response logging in development. Set value to truthy string to enable, leave empty value or comment out to disable
# ENABLE_HTTP_LOGGER=""
# This enables timestamps for the HTTP Logger. Set value to true to enable, leave empty or comment out to disable
# ENABLE_HTTP_LOGGER_TIMESTAMPS=""
