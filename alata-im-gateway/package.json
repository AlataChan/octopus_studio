{
  "name": "alata-im-gateway",
  "version": "0.1.0",
  "description": "Standalone IM Gateway for Alata Studio (Feishu + WeCom)",
  "main": "src/index.js",
  "bin": {
    "alata-gateway": "./bin/alata-gateway.js"
  },
  "scripts": {
    "start": "node bin/alata-gateway.js run",
    "start:prod": "NODE_ENV=production node bin/alata-gateway.js run",
    "dev": "node --watch bin/alata-gateway.js run",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest test/unit --runInBand --forceExit",
    "test:integration": "jest test/integration --runInBand --forceExit",
    "db:init": "node src/db/init.js"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.62.1",
    "axios": "^1.7.0",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "fastq": "^1.17.0",
    "joi": "^17.13.0",
    "node-cache": "^5.1.2",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "jest": "^30.0.0",
    "nock": "^14.0.0",
    "supertest": "^7.0.0"
  }
}
