VITE_API_BASE='http://localhost:3001/api' # Use this URL when developing locally
# VITE_API_BASE="https://$CODESPACE_NAME-3001.$GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN/api" # for GitHub Codespaces
# VITE_API_BASE='/api' # Use this URL deploying on non-localhost address OR in docker.

# 公告功能 - 默认禁用，需要时设为 true 并提供自托管 URL
VITE_ANNOUNCEMENTS_ENABLED=false
VITE_ANNOUNCEMENTS_URL=
VITE_ANNOUNCEMENTS_LIST_PATH=/list.txt

# Focus default navigation on the first sellable FDE workflow loop. Set false
# to restore compatibility navigation without deleting or disabling routes.
VITE_STUDIO_FOCUSED_SURFACE=true
