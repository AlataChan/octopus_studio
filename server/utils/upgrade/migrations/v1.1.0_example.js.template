   * - 此处主要处理数据转换、字段迁移等特定操作
   */
  async up() {
    try {
      // 示例 1: 数据迁移
      // const records = await prisma.some_table.findMany({
      //   where: { oldField: { not: null } }
      // });
      // for (const record of records) {
