# 必须替换所有占位密钥后才能启动生产容器。
# NODE_ENV=production 会拒绝 change-me / example / placeholder 等占位值。
# 生成命令：openssl rand -hex 32

SERVER_PORT=3001
STORAGE_DIR="/app/server/storage"
UID='1000'
GID='1000'

# 生产必改（强随机）
JWT_SECRET="change-me-use-strong-random"
AUTH_TOKEN="change-me-use-strong-random"
SIG_KEY='change-me-use-strong-random-32plus'
SIG_SALT='change-me-use-strong-random-32plus'
INTERNAL_API_SECRET='change-me-docker-internal-secret'
ALATA_GATEWAY_API_KEY='ak-alata-docker-gateway-change-me'

# 云端推荐：直接调用 API Key（不要部署 Ollama）
LLM_PROVIDER='deepseek'
DEEPSEEK_API_KEY='your-deepseek-api-key-here'
DEEPSEEK_MODEL_PREF='deepseek-chat'

# Embedding：二选一
# A) native（本地嵌入，模型缓存到 STORAGE_DIR）
EMBEDDING_ENGINE='native'
EMBEDDING_MODEL_PREF='Xenova/all-MiniLM-L6-v2'

# B) openai（云端 embedding API）
# EMBEDDING_ENGINE='openai'
# OPEN_AI_KEY='sk-xxxx'
# EMBEDDING_MODEL_PREF='text-embedding-3-small'

# Vector DB（默认 lancedb，数据落在 STORAGE_DIR）
VECTOR_DB='lancedb'

# 安全建议
DISABLE_TELEMETRY='true'
# 本机默认值；生产部署请替换为真实前端来源，或显式使用 * 允许所有来源。
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Optional IM Gateway runtime bridge
# 启用 compose profile gateway 时使用
GATEWAY_CONFIG_MODE='standalone'
GATEWAY_PORT='3100'
