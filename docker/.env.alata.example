# ========================================
# Alata Studio 环境配置示例
# ========================================
# 必须替换所有占位密钥后才能启动生产容器。
# NODE_ENV=production 会拒绝 change-me / example / placeholder 等占位值。
# 生成命令：openssl rand -hex 32
#
# 复制此文件为 .env 并修改配置
# cp .env.alata.example .env

# ----------------------------------------
# 业务数据层（必需）
# ----------------------------------------
# Docker Compose 内使用:
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/alata

# 本地开发使用 SQLite:
# DATABASE_URL=sqlite://./storage/alata.db

# ----------------------------------------
# 临时分析层（可选）
# 用于"上传文件分析"功能
# 不配置时，该功能关闭，其他功能不受影响
# ----------------------------------------

# 启用临时分析层
ENABLE_TEMP_ANALYSIS=true

# 存储后端类型：local（本地文件系统）或 s3（S3/MinIO）
# 生产环境若希望使用 MinIO/S3，这里必须设为 s3，否则会回退为本地存储。
STORAGE_BACKEND=s3

# MinIO/S3 配置
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=alata-analysis
S3_REGION=us-east-1

# 文件保留天数（默认 30 天）
ANALYSIS_FILE_RETENTION_DAYS=30

# 单文件最大大小（默认 500MB）
ANALYSIS_FILE_MAX_SIZE=524288000

# ----------------------------------------
# 知识层（必需）
# ----------------------------------------
VECTOR_DB=lancedb

# 可选: 使用 Chroma
# VECTOR_DB=chroma
# CHROMA_ENDPOINT=http://localhost:8000

# ----------------------------------------
# 定时任务配置
# ----------------------------------------
ENABLE_CRON=true

# 知识同步时间（cron 表达式，默认每天凌晨 2:00）
KNOWLEDGE_SYNC_SCHEDULE=0 2 * * *

# ----------------------------------------
# LLM 配置（云端推荐：直接调用 API Key，不部署 Ollama）
# ----------------------------------------
# 选择 LLM Provider（示例：DeepSeek / OpenAI）
LLM_PROVIDER=deepseek
# LLM_PROVIDER=openai

# DeepSeek 配置（必填）
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL_PREF=deepseek-chat

# OpenAI 配置（如使用 OpenAI，取消注释）
# OPEN_AI_KEY=sk-xxx
# OPEN_MODEL_PREF=gpt-4o-mini

# ----------------------------------------
# Embedding 配置
# ----------------------------------------
# Lite Compose (`docker-compose.lite.yml`) 会强制 LIGHTWEIGHT_MODE=true，
# 因此这里默认给出“云端 embedding”示例，避免与 native 冲突。
EMBEDDING_ENGINE=jina
EMBEDDING_MODEL_PREF=jina-embeddings-v2-base-en
JINA_API_KEY=your-jina-api-key-here

# 选项 B：openai（云端 embedding API）
# EMBEDDING_ENGINE=openai
# OPEN_AI_KEY=sk-xxx
# EMBEDDING_MODEL_PREF=text-embedding-3-small

# 选项 C：native（仅建议在 `docker-compose.alata.yml` / 非 Lite 模式下使用）
# EMBEDDING_ENGINE=native
# EMBEDDING_MODEL_PREF=Xenova/all-MiniLM-L6-v2

# ----------------------------------------
# 其他配置
# ----------------------------------------
NODE_ENV=production
SERVER_PORT=3001
# Lite compose 本机默认值；生产部署请替换为真实前端来源，或显式使用 * 允许所有来源。
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Agent Flow 运行（默认禁用，未实现）
AGENT_FLOW_RUN_ENABLED=false
VITE_AGENT_FLOW_RUN_ENABLED=false

# SQL Agent 安全
SQL_AGENT_WRITE_ENABLED=false
SQL_AGENT_DEFAULT_ROW_LIMIT=1000
SQL_AGENT_STATEMENT_TIMEOUT_MS=10000

# Billing / 用量告警（默认禁用，未实现完整）
BILLING_ENABLED=false
VITE_BILLING_ENABLED=false

# 内部实验/AB 测试
EXPERIMENT_LABEL=default_experiment
EXPERIMENTS_ADMIN_ENABLED=false

# SGA-Molt 集成（用户在 sga-molt-isolated project 部署 SGA-Molt 后启用）
MOLT_ENABLED=true
MOLT_BASE_URL=http://host.docker.internal:18889
MOLT_DASHBOARD_URL=http://127.0.0.1:18889
MOLT_DEFAULT_AGENT_ID=molt-matrix
MOLT_SYNC_ENABLED=false
MOLT_SYNC_INTERVAL_MS=300000
# 完成 Octopus setup wizard 后填写 finalize 生成的 sk-molt-xxx API key
MOLT_API_TOKEN=
# 可选：Matrix 一键初始化专用 token；不填则尝试复用 MOLT_API_TOKEN
MOLT_ADMIN_TOKEN=
# 可选：如果用文件传 API key，请挂载 API key 文件；不要指向 gateway.token
# MOLT_API_TOKEN_FILE=/run/molt/api.token

# JWT 密钥（生产环境必须修改）
JWT_SECRET=your-super-secret-jwt-key-change-me

# 单用户模式密码（浏览器登录时使用）
AUTH_TOKEN=change-me-single-user-password

# 签名 / 加密密钥（生产环境必须修改）
SIG_KEY=sig-key-change-me
SIG_SALT=sig-salt-change-me

# 主服务内部接口密钥（供 gateway / 其他 sidecar 调用内部 API）
INTERNAL_API_SECRET=change-me-docker-internal-secret

# 存储路径
STORAGE_DIR=/app/server/storage

# ----------------------------------------
# IM Gateway runtime bridge
# compose 默认会启动该服务，下面两个值用于让 gateway 自动接入主服务
# ----------------------------------------
GATEWAY_CONFIG_MODE=standalone
GATEWAY_PORT=3100
ADMIN_SECRET=admin-secret-change-me
ALATA_GATEWAY_API_KEY=ak-alata-docker-gateway-change-me
