    "volc.seedance_2_0_mini": {
      "provider": "volcengine_ark",
      "model": "doubao-seedance-2-0-mini-260615",
      "adapter": "ark_content_video",
      "capabilities": ["video.text", "video.image", "video.multimodal", "audio.reference"],
      "quality": "final",
      "pricing": {"price": 0.30, "unit": "second", "currency": "CNY", "verify": true},
      "notes": "Good default for multi-reference video on Ark content generation tasks."
    },
