{
  "providers": {
    "volcengine_ark": {
      "display_name": "Volcengine Ark",
      "env_key": "ARK_API_KEY",
      "submit_url": "https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks",
      "poll_url": "https://ark.cn-beijing.volces.com/api/v3/contents/generations/tasks/{task_id}"
    },
    "aliyun_dashscope": {
      "display_name": "Alibaba Cloud Model Studio / DashScope",
      "env_key": "DASHSCOPE_API_KEY",
      "base_url_env": "DASHSCOPE_BASE_URL",
      "default_base_url": "https://dashscope.aliyuncs.com/api/v1"
    },
    "agnes": {
      "display_name": "Agnes AI",
      "env_key": "AGNES_API_KEY",
      "base_url": "https://apihub.agnes-ai.com"
    }
  },
  "budget": {
    "usd_cny_rate": 7.2,
    "confirm_threshold_cny": 1.0,
    "session_cap_cny": 10.0
  },
  "routes": {
    "image.poster.draft": [
      "agnes.image_flash",
      "aliyun.wan2_7.image",
      "aliyun.qwen_image_2.pro"
    ],
    "image.poster.final": [
      "agnes.image_flash",
      "aliyun.qwen_image_2.pro",
      "aliyun.wan2_7.image"
    ],
    "image.edit": [
      "agnes.image_flash",
      "aliyun.wan2_7.i2v",
      "aliyun.happyhorse_1_0.video_edit"
    ],
    "video.text.draft": [
      "agnes.video_v2",
      "volc.seedance_1_0_pro_fast",
      "aliyun.wan2_7.t2v",
      "aliyun.happyhorse_1_1.t2v",
      "volc.seaweed"
    ],
    "video.image.draft": [
      "agnes.video_v2",
      "aliyun.wan2_7.i2v",
      "volc.seedance_1_0_lite_i2v"
    ],
    "video.final": [
      "agnes.video_v2",
      "volc.seedance_2_0_mini",
      "volc.seedance_1_5_pro",
      "aliyun.wan2_7.t2v"
    ],
    "video.multimodal": [
      "agnes.video_v2",
      "volc.seedance_2_0_mini",
      "aliyun.wan2_7.r2v"
    ],
    "video.edit": [
      "aliyun.wan2_7.videoedit",
      "aliyun.happyhorse_1_0.video_edit"
    ]
  },
